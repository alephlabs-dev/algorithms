{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  // e2e and the prerender plugin import the route registry (src/routes.ts), so it and every file it imports must be
  // included (a composite project only checks included files). Each module's manifest, and the types.ts it may
  // import, are found by glob (docs/adr/0003).
  "include": ["vite.config.ts", "vite-plugin-prerender.ts", "playwright.config.ts", "e2e", "src/routes.ts", "src/i18n.ts",
    "src/modules/*/manifest.ts", "src/modules/*/types.ts"]
}
